# ========================================================
# YatraLocal — LLM Planner Environment Configuration
# ========================================================
# Copy this file to .env and insert your real API key.
# This file is NEVER committed to git and NEVER exposed to client browsers.

# Primary LLM API Key (Google Gemini API or OpenAI compatible)
LLM_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-2.5-flash or gemini-1.5-flash)
LLM_MODEL=gemini-2.5-flash

# Optional: Custom endpoint for OpenAI-compatible proxies (leave blank for standard Gemini API)
# LLM_API_URL=https://api.openai.com/v1/chat/completions

# Rate Limiting (Requests per minute per IP, default: 10)
RATE_LIMIT_PER_MINUTE=10
