# ========================================================
# YatraLocal — LLM Planner Environment Configuration
# ========================================================
# Copy this file to .env and insert your real API key.
# This file is NEVER committed to git and NEVER exposed to client browsers.

# Primary LLM API Key (Google Gemini API or OpenAI compatible)
LLM_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-2.5-flash or gemini-1.5-flash)
LLM_MODEL=gemini-2.5-flash

# Optional: Custom endpoint for OpenAI-compatible proxies (leave blank for standard Gemini API)
# LLM_API_URL=https://api.openai.com/v1/chat/completions

# Rate Limiting (Requests per minute per IP, default: 10)
RATE_LIMIT_PER_MINUTE=10

# ========================================================
# Phase 13: Emergency SOS SMS & WhatsApp Alerts (Twilio)
# ========================================================
# Required for real SMS alert delivery to emergency contacts.
# If omitted or unconfigured, YatraLocal uses zero-backend client fallback
# (prefilled native SMS and WhatsApp deep links).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890
# Optional: Twilio WhatsApp sender (e.g., whatsapp:+14155238886 for Twilio Sandbox)
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

